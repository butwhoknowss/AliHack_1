# Copy to .env and fill in. Never commit .env.
WEATHERAPI_KEY=
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api
WEATHERAPI_BASE_URL=https://api.weatherapi.com/v1
# NASA Giovanni satellite variables (GPM, MODIS, OMI, AIRS, GLDAS) need a free Earthdata Login
# (https://urs.earthdata.nasa.gov/users/new). Username + password is the most reliable option;
# EARTHDATA_TOKEN (Earthdata "Generate Token") is tried if no username/password is given.
GIOVANNI_BASE_URL=https://api.giovanni.earthdata.nasa.gov
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
EARTHDATA_TOKEN=
DATA_DIR=./data
CACHE_TTL_DAYS=30
HTTP_TIMEOUT_SECONDS=60
LOG_LEVEL=INFO
# Extra CORS origins, comma-separated (Live Server 127.0.0.1:5500 is always allowed)
CORS_ORIGINS=
